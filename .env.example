# Environment Configuration for Conduit UCPI Contracts

# Deployment Configuration
RELAYER_WALLET_PRIVATE_KEY=  # GitHub: secrets
NETWORK=base                                                                       # GitHub: vars
CHAIN_ID=8453                                                                             # GitHub: vars
NETWORK_RPC_URL=https://base.mainenet.org                                                  # GitHub: vars

# Fallback arbitrator Safe (EscrowContract.DEFAULT_ARBITER)                               # GitHub: vars
#
# ⚠️ THE ONE PARAMETER THAT CAN NEVER BE CHANGED. It is baked into the escrow
#    IMPLEMENTATION's bytecode and shared by every clone, so rotating it means deploying a
#    new implementation -> new ERC-1167 codehash -> new factory AND new marketplace.
#    It MUST therefore be a multisig whose signers can rotate while the address stays fixed.
#
#    The deploy script has no default and will refuse to run if this is unset, zero, equal
#    to the relayer/owner, or has no deployed code on the target chain. That last check
#    means the Safe must already exist on whatever network you are deploying to (including
#    testnets - use a test Safe there).
#
# Base mainnet "stabledropAdmin" Safe (2-of-3, Safe v1.4.1):
DEFAULT_ARBITER_ADDRESS=0x9bB8e809EA6F5A74f46027D8016641D9cE9A149C

# Token Addresses
USDC_CONTRACT_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Verification Configuration
VERIFIER_API_KEY=your_verifier_api_key_here                                               # GitHub: secrets
VERIFIER_URL=https://api-sepolia.basescan.org/api                                         # GitHub: vars

# Network Reference Examples:
# Base Sepolia (Testnet): CHAIN_ID=84532, NETWORK=base-sepolia, USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base Mainnet: CHAIN_ID=8453, NETWORK=base, USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Avalanche Fuji: CHAIN_ID=43113, NETWORK=fuji, USDC=0x5425890298aed601595a70AB815c96711a31Bc65
# Avalanche Mainnet: CHAIN_ID=43114, NETWORK=avalanche
# Ethereum Sepolia: CHAIN_ID=11155111, NETWORK=sepolia
# Ethereum Mainnet: CHAIN_ID=1, NETWORK=mainnet
